graph LR
    %% Global Styles
    classDef actorStyle fill:#00d1ff,stroke:#fff,stroke-width:2px,color:#000,font-weight:bold,font-size:20px;
    classDef usecaseStyle fill:#fff,stroke:#333,stroke-width:2px,color:#000,font-weight:bold,font-size:16px;
    classDef packageStyle fill:#f9f9f9,stroke:#999,stroke-width:2px,color:#333,font-size:22px;

    subgraph System ["Vulnerability Management System / نظام إدارة الثغرات"]
        direction TB

        %% Use Cases
        UC_Login(["<b>تسجيل الدخول</b><br/>Login"])
        UC_Invite(["<b>توليد روابط الدعوات</b><br/>Generate Invitations"])
        UC_Roles(["<b>إدارة الأدوار والصلاحيات</b><br/>Manage Roles & Permissions"])
        UC_Logs(["<b>مراجعة سجلات النظام</b><br/>Review System Logs"])

        UC_AddDomain(["<b>إضافة نطاق جديد</b><br/>Add New Domain"])
        UC_Verify(["<b>التحقق من الملكية</b><br/>HTTP-01 Verification"])
        UC_Bypass(["<b>تجاوز التحقق للمواقع الموثوقة</b><br/>Bypass Verification (Whitelist)"])

        UC_StartScan(["<b>بدء فحص أمني جديد</b><br/>Start Security Scan"])
        UC_RunTools(["<b>تشغيل أدوات الفحص</b><br/>Run Nmap, Nikto, SQLmap, FFuf"])

        UC_ViewResults(["<b>عرض نتائج الفحص</b><br/>View Scan Results"])
        UC_Vector(["<b>تحليل ناقل الهجوم</b><br/>Attack Vector Analysis"])
        UC_Remediation(["<b>متابعة حالة المعالجة</b><br/>Track Remediation Status"])

        UC_ExportPDF(["<b>تصدير تقرير PDF</b><br/>Export PDF Report"])
        UC_ExecReport(["<b>تصدير تقرير تنفيذي</b><br/>Export Executive Report"])
        UC_CVE_Mgmt(["<b>إدارة بيانات CVEs</b><br/>Manage CVE Intelligence"])

        %% Internal Relationships
        UC_AddDomain -.->|include| UC_Verify
        UC_StartScan -.->|include| UC_RunTools
        UC_ViewResults -.->|include| UC_Vector
        UC_ViewResults -.->|include| UC_Remediation
        UC_ExecReport -.->|extend| UC_ExportPDF
    end

    %% Actors
    Admin["<b>Admin / المسؤول</b>"]
    User["<b>User / المستخدم</b>"]

    %% Actor Relationships
    User --- UC_Login
    User --- UC_AddDomain
    User --- UC_StartScan
    User --- UC_ViewResults
    User --- UC_ExportPDF

    Admin --- User
    Admin --- UC_Invite
    Admin --- UC_Roles
    Admin --- UC_Logs
    Admin --- UC_Bypass
    Admin --- UC_CVE_Mgmt
    Admin --- UC_ExecReport

    %% Apply Classes
    class Admin,User actorStyle;
    class UC_Login,UC_Invite,UC_Roles,UC_Logs,UC_AddDomain,UC_Verify,UC_Bypass,UC_StartScan,UC_RunTools,UC_ViewResults,UC_Vector,UC_Remediation,UC_ExportPDF,UC_ExecReport,UC_CVE_Mgmt usecaseStyle;
    class System packageStyle;
